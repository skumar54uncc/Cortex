{
  "name": "cortex",
  "version": "1.2.0",
  "private": true,
  "description": "Local second brain for everything you read on the web",
  "scripts": {
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run eval:test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "watch": "webpack --mode development --watch",
    "icons": "node scripts/generate-icons-from-brand.mjs",
    "prepare-model": "node scripts/download-model.mjs",
    "eval:seed": "tsx eval/src/seed-cli.ts",
    "eval": "tsx eval/src/cli.ts",
    "eval:baseline": "tsx eval/src/cli.ts --baseline",
    "eval:test": "vitest run --config vitest.config.eval.ts",
    "e2e": "playwright test",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file sbom.cdx.json",
    "build:e2e": "webpack --mode production --env e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.0.10",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.268",
    "@vitest/ui": "^4.1.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "undici": "^7.29.1",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.6",
    "vite": "^8.3.0",
    "fflate": "^0.8.3",
    "postcss-selector-parser": "^7.1.3",
    "esbuild": "^0.28.2"
  }
}
